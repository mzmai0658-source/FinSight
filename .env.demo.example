# 作品说明：FinSight 无商业 API Key 演示配置。
# 作品说明：复制为 .env.demo，并按本机 MySQL 修改 DB_USER / DB_PASSWORD。

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_CONTEXT_LENGTH=16384
LLM_MAX_TOKENS=3072
OLLAMA_REASONING_EFFORT=none

EMBEDDING_PROVIDER=bge_local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=
CHROMA_DB_PATH=data/demo_chroma_db

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=finsight_demo
DB_CHARSET=utf8mb4

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=finsight_demo

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

SERVER_PORT=8080
AGENT_BASE_URL=http://127.0.0.1:8000
JWT_SECRET=replace-this-demo-secret-before-any-nonlocal-deployment
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
CHAT_QUOTA_PER_DAY=100
ETL_INGEST_RAG=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=

# 作品说明：内部服务凭据为空时，由本机启动脚本生成私有值。
INTERNAL_API_TOKEN=
# 作品说明：Agent 使用独立只读账号，与数据导入及 Java 的 DB_USER 分离。
SQL_DB_USER=
SQL_DB_PASSWORD=
SQL_QUERY_TIMEOUT_MS=5000
ADVISOR_ENABLED=false
FINANCIAL_FACTS_MANIFEST=data/runtime/demo-v3/facts.json
