# 作品说明：本机运行前将此公开配置模板复制为 .env。
# 作品说明：PowerShell 启动器读取 .env，并同步 Python DB_* 与 Java MYSQL_* 配置。

# 作品说明：对话模型配置。
# 作品说明：对话服务支持 ollama、openai_compat 与兼容自动选择。
# 作品说明：参赛主路径使用本机 Ollama；远端开发服务须显式选择 openai_compat。
# 作品说明：auto 仅用于兼容旧部署：检测到旧 API Key 时沿用远端，否则使用 Ollama。
LLM_PROVIDER=ollama
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=
# 作品说明：限制单次输出，避免本地小模型重复生成直至超时；不影响 16384 输入上下文。
LLM_MAX_TOKENS=4096
# 作品说明：默认关闭可配置思考，显式设置 low 才启用。
OLLAMA_REASONING_EFFORT=none

# 作品说明：本地开源模型无需商业 API 密钥。
# 作品说明：兼容接口不接受请求级上下文参数，需要在 Ollama 服务端设置。
# 作品说明：服务端通过 OLLAMA_CONTEXT_LENGTH=16384 设置窗口后启动 ollama serve。
# 作品说明：实际窗口不足时给出提示，防止长工具定义或检索片段被截断。
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_CONTEXT_LENGTH=16384

# 作品说明：向量模型配置。
# 作品说明：向量服务支持 bge_local、dashscope 与兼容自动选择。
# 作品说明：参赛主路径使用本机 BGE；DashScope 仅在显式选择时用于开发。
# 作品说明：auto 仅用于兼容旧部署：有旧 Key 时沿用 DashScope，否则使用 BGE。
# 作品说明：切换向量服务会使旧索引空间失效，需重新构建索引。
# 作品说明：使用 python scripts/rebuild_kb.py 重建，构建模型写入向量集合元数据。
# 作品说明：查询时核对构建模型身份，避免混用不兼容向量。
EMBEDDING_PROVIDER=bge_local
EMBEDDING_MODEL=
EMBEDDING_DEVICE=
# 作品说明：本地 BGE 批量编码/写入大小；显存不足时可调低，远端 Provider 默认仍为 10。
EMBEDDING_UPSERT_BATCH_SIZE=64
# 作品说明：留空使用 data/chroma_db；demo 配置使用 data/demo_chroma_db，避免覆盖正式索引。
CHROMA_DB_PATH=

# 作品说明：可选远端服务配置，保留旧变量兼容。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_RETRIES=5
DASHSCOPE_API_KEY=
DASHSCOPE_MAX_RETRIES=3
DASHSCOPE_RETRY_BACKOFF_SECONDS=1.5

# 作品说明：PDF 转 OCR JSON 时使用已配置的 PaddleOCR 异步服务。
OCR_API_URL=
OCR_API_PROTOCOL=paddle_async
OCR_MODEL=PaddleOCR-VL-1.6
OCR_TIMEOUT_SECONDS=3600
OCR_POLL_INTERVAL_SECONDS=5
# 作品说明：旧缓存身份绑定须显式迁移，新上传默认不允许未绑定缓存。
OCR_CACHE_ALLOW_LEGACY=false
PADDLEOCR_API_TOKEN=
OCR_API_TOKEN=

# 作品说明：Python MySQL 连接配置。
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=financial_report
DB_CHARSET=utf8mb4

# 作品说明：Java MySQL 配置为空时，启动器从 DB_* 同步对应值。
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# 作品说明：Redis 缓存及令牌生命周期配置。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 作品说明：RabbitMQ 异步任务配置。
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# 作品说明：Java 服务配置。
SERVER_PORT=8080
AGENT_BASE_URL=http://127.0.0.1:8000
JWT_SECRET=replace-this-local-secret-with-a-private-generated-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
CHAT_QUOTA_PER_DAY=100
ETL_UPLOAD_DIR=../data_root/uploads
ETL_INGEST_RAG=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 作品说明：前端地址为空时使用 Vite 开发代理。
VITE_API_BASE_URL=

# 作品说明：内部服务凭据为空时，由本机启动脚本生成私有值。
INTERNAL_API_TOKEN=
# 作品说明：Agent 使用独立只读账号，与数据导入及 Java 的 DB_USER 分离。
SQL_DB_USER=
SQL_DB_PASSWORD=
SQL_QUERY_TIMEOUT_MS=5000
ADVISOR_ENABLED=false
FINANCIAL_FACTS_MANIFEST=
# 作品说明：结构化 Agent 的规划和回答组织共享模型预算，执行上限为 240 秒。
AGENT_TURN_TIMEOUT_SECONDS=240
