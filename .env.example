# 作品说明：本机运行前将此公开配置模板复制为 .env。
# 作品说明：PowerShell 启动器读取 .env，并同步 Python DB_* 与 Java MYSQL_* 配置。

# 作品说明：对话模型配置。
# 作品说明：生成服务统一为云端兼容协议；缺密钥或配置错误不切换模型。
# 作品说明：当前问答、解释和审核使用DeepSeek；新向量索引使用百炼。
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=0
# 作品说明：结构化理解、解释和审核共用3072单次输出上限。
LLM_MAX_TOKENS=3072
# 作品说明：生成请求固定temperature=0、thinking disabled；云端窗口由服务方管理。

# 作品说明：向量模型配置。
# 作品说明：新上传与检索统一使用百炼 text-embedding-v4、1024维；缺密钥或服务错误直接失败。
# 作品说明：旧 auto 名称也固定使用云端，绝不隐式下载本地模型。
# 作品说明：BGE历史库保留原路径，仅显式回滚时选择 bge_local 和原模型/路径。
# 作品说明：使用 python scripts/rebuild_kb.py 重建，构建模型写入向量集合元数据。
# 作品说明：查询时核对构建模型身份，避免混用不兼容向量。
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
# 作品说明：EMBEDDING_DEVICE仅在显式读取历史BGE库时使用。
EMBEDDING_DEVICE=
# 作品说明：每次HTTP最多10条、每条最多8192Token；适配器先按8192 UTF-8字节保守校验。
EMBEDDING_UPSERT_BATCH_SIZE=10
# 作品说明：新库使用独立路径，不覆盖原 data/chroma_db BGE库。
CHROMA_DB_PATH=data/chroma_cloud_v4_1024
# 作品说明：严格审核发布为默认策略；本机选择118份试验资料时须同时显式设置下列两项。
# 作品说明：ocr-trial-v1 仍展示待核验标记，不会升级为原件全部审核完成。
FINSIGHT_DATA_PROFILE=strict
FINSIGHT_OCR_TRIAL=false
DASHSCOPE_API_KEY=
# 作品说明：从百炼控制台复制本账户/地域的HTTPS /api/v1地址到私有环境；不得直接使用WorkspaceId占位符。
DASHSCOPE_HTTP_BASE_URL=
# 作品说明：可选完整HTTP text-embedding端点，填写后优先于上方base URL。
DASHSCOPE_EMBEDDING_ENDPOINT=
DASHSCOPE_TIMEOUT_SECONDS=30
# 作品说明：0仍发送首次请求；最多2次额外重试，认证/余额/配额错误不重试。
DASHSCOPE_MAX_RETRIES=0
DASHSCOPE_RETRY_BACKOFF_SECONDS=1

# 作品说明：PDF 转 OCR JSON 时使用已配置的 PaddleOCR 异步服务。
OCR_API_URL=
OCR_API_PROTOCOL=paddle_async
OCR_MODEL=PaddleOCR-VL-1.6
OCR_TIMEOUT_SECONDS=3600
OCR_POLL_INTERVAL_SECONDS=5
# 作品说明：旧缓存身份绑定须显式迁移，新上传默认不允许未绑定缓存。
OCR_CACHE_ALLOW_LEGACY=false
PADDLEOCR_API_TOKEN=
OCR_API_TOKEN=

# 作品说明：Python MySQL 连接配置。
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=financial_report
DB_CHARSET=utf8mb4

# 作品说明：Java MySQL 配置为空时，启动器从 DB_* 同步对应值。
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# 作品说明：Redis 缓存及令牌生命周期配置。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 作品说明：RabbitMQ 异步任务配置。
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# 作品说明：Java 服务配置。
SERVER_PORT=8080
AGENT_BASE_URL=http://127.0.0.1:8000
JWT_SECRET=replace-this-local-secret-with-a-private-generated-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
CHAT_QUOTA_PER_DAY=100
ETL_UPLOAD_DIR=../data_root/uploads
ETL_INGEST_RAG=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 作品说明：前端地址为空时使用 Vite 开发代理。
VITE_API_BASE_URL=

# 作品说明：内部服务凭据为空时，由本机启动脚本生成私有值。
INTERNAL_API_TOKEN=
# 作品说明：Agent 使用独立只读账号，与数据导入及 Java 的 DB_USER 分离。
SQL_DB_USER=
SQL_DB_PASSWORD=
SQL_QUERY_TIMEOUT_MS=5000
ADVISOR_ENABLED=false
FINANCIAL_FACTS_MANIFEST=
# 作品说明：OCR为正文及表格主来源，PDF文字仅核对身份、单元格和逐字摘录。
PDF_TEXT_EXTRACTOR=pymupdf
# 作品说明：结构化 Agent 的规划和回答组织共享模型预算，执行上限为 240 秒。
AGENT_TURN_TIMEOUT_SECONDS=240
