# 作品说明：隔离样例库配置；现行真实财报运行请使用.env.example。
# 作品说明：复制为 .env.demo，并按本机 MySQL 修改 DB_USER / DB_PASSWORD。

LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=0
LLM_MAX_TOKENS=3072

# 作品说明：新示例库也使用百炼1024维云端向量；历史BGE库保留在data/demo_chroma_db。
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=
EMBEDDING_UPSERT_BATCH_SIZE=10
CHROMA_DB_PATH=data/demo_chroma_cloud_v4_1024
DASHSCOPE_API_KEY=
# 作品说明：在私有环境填写百炼控制台提供的本账户/地域HTTPS /api/v1地址。
DASHSCOPE_HTTP_BASE_URL=
DASHSCOPE_EMBEDDING_ENDPOINT=
DASHSCOPE_TIMEOUT_SECONDS=30
DASHSCOPE_MAX_RETRIES=0
DASHSCOPE_RETRY_BACKOFF_SECONDS=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=finsight_demo
DB_CHARSET=utf8mb4

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=finsight_demo

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

SERVER_PORT=8080
AGENT_BASE_URL=http://127.0.0.1:8000
JWT_SECRET=replace-this-demo-secret-before-any-nonlocal-deployment
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
CHAT_QUOTA_PER_DAY=100
ETL_INGEST_RAG=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=

# 作品说明：内部服务凭据为空时，由本机启动脚本生成私有值。
INTERNAL_API_TOKEN=
# 作品说明：Agent 使用独立只读账号，与数据导入及 Java 的 DB_USER 分离。
SQL_DB_USER=
SQL_DB_PASSWORD=
SQL_QUERY_TIMEOUT_MS=5000
ADVISOR_ENABLED=false
FINANCIAL_FACTS_MANIFEST=data/runtime/demo-v3/facts.json
